# ad-spy-kit runs keyless on bundled fixtures. Each key below switches on one live path.
# The StealAds MCP (primary path) needs no key here: it authenticates inside your agent via OAuth.

# Alternate path: live Meta Ad Library pulls when the StealAds MCP isn't connected. https://scrapecreators.com
SCRAPECREATORS_API_KEY=

# Opt-in enhanced transcripts (speech + on-screen text) via OpenRouter. Off by default.
# Turn on: AD_SPY_TRANSCRIBE=openrouter (or ./doctor.sh --transcribe on). Paid per video.
# Without OPENROUTER_API_KEY the kit says so and uses ScrapeCreators. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# AD_SPY_TRANSCRIBE=scrapecreators
# AD_SPY_TRANSCRIBE_MODEL=google/gemini-3.8-flash   # or openai/gpt-audio-mini (audio only)
